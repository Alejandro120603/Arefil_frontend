# Overrides for the HTTPS deployment (compose.yaml). Copy to `.env` and adjust.
# No passwords, tokens or private keys belong here: the first ADMIN is created
# with the backend CLI (see README "Despliegue").
AREFIL_UID=1000
AREFIL_GID=1000

# Public name and origin of the panel (include the port if HTTPS_PORT != 443).
AREFIL_HOSTNAME=arefil.example.internal
AREFIL_PUBLIC_ORIGIN=https://arefil.example.internal
HTTPS_PORT=443
HTTP_PORT=80

# Certificate source: `internal` (Caddy local CA), cert/key files placed in
# deploy/certs/ ("/certs/arefil.crt /certs/arefil.key"), or an e-mail for Let's Encrypt.
AREFIL_TLS=internal

# Private network between frontend and backend, and the frontend's fixed address
# in it: the backend trusts X-Forwarded-For only from that address. Change both
# together if the subnet collides with another network.
AREFIL_INTERNAL_SUBNET=172.31.240.0/24
AREFIL_FRONTEND_INTERNAL_IP=172.31.240.10

SESSION_TTL_HOURS=12
BACKEND_DATA_DIR=../Arefil_backend/backend/data
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=arefil
