# Optional overrides for Docker Compose. `make docker_*` supplies the current
# host UID/GID automatically; set these explicitly only when using Compose
# directly or when the data directory belongs to a different account.
AREFIL_UID=1000
AREFIL_GID=1000

FRONTEND_PORT=3001
BACKEND_PORT=8000
BACKEND_DATA_DIR=../Arefil_backend/backend/data
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]
COMPOSE_PROJECT_NAME=arefil
