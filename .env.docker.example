# Overrides for the HTTPS deployment (compose.yaml). Copy to `.env` and adjust.
# No passwords, tokens or private keys belong here: AREFIL needs no application
# secrets, and the first ADMIN is created with the backend CLI (README "Despliegue").
COMPOSE_PROJECT_NAME=arefil
AREFIL_UID=1000
AREFIL_GID=1000

# Persistent data (arefil.db, uploads/, backups/). Relative to this repo. The
# deploy refuses to start if arefil.db is missing here (see AREFIL_ALLOW_NEW_DATABASE).
BACKEND_DATA_DIR=../Arefil_backend/backend/data
# true only for the very first start of a brand-new installation; then remove it.
AREFIL_ALLOW_NEW_DATABASE=false

# Public origin of the panel, exactly as the browser shows it (scheme + host
# [+ port]). Becomes the backend's CORS_ORIGINS and TRUSTED_ORIGINS.
AREFIL_PUBLIC_ORIGIN=https://arefil.example.com

# ---- Edge A: Cloudflare Tunnel (cloudflared runs on the host) ----------------
# The tunnel's public hostname must point to http://127.0.0.1:${FRONTEND_PORT}.
COMPOSE_FILE=compose.yaml:compose.cloudflare.yaml
FRONTEND_PORT=3001

# ---- Edge B: Caddy on this host (remove COMPOSE_FILE above) ------------------
# Certificate source: `internal` (Caddy local CA), cert/key files placed in
# deploy/certs/ ("/certs/arefil.crt /certs/arefil.key"), or an e-mail for Let's Encrypt.
# AREFIL_HOSTNAME=arefil.example.internal
# AREFIL_TLS=internal
# HTTPS_PORT=443
# HTTP_PORT=80

# Private network between frontend and backend, and the frontend's fixed address
# in it: the backend trusts X-Forwarded-For only from that address. Change both
# together if the subnet collides with another network.
AREFIL_INTERNAL_SUBNET=172.31.240.0/24
AREFIL_FRONTEND_INTERNAL_IP=172.31.240.10

SESSION_TTL_HOURS=12
LOG_LEVEL=INFO
REPORT_EXECUTION_CLEANUP_ENABLED=true
REPORT_EXECUTION_CLEANUP_INTERVAL_SECONDS=3600
REPORT_EXECUTION_CLEANUP_BATCH_SIZE=500
REPORT_EXECUTION_CLEANUP_MAX_RECORDS=5000

# Obsolete (old compose without an HTTPS edge; ignored now): CORS_ORIGINS, BACKEND_PORT.
