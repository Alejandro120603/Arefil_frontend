# Browser: same-origin proxy by default. This value is embedded at build time.
NEXT_PUBLIC_API_URL=/backend-api

# Next.js server and proxy: evaluated at runtime.
API_INTERNAL_URL=http://127.0.0.1:8000/api

# Stimulsoft Reports.JS licence key, read at build time and embedded in the
# client bundle. Reports.JS renders reports in the browser, so the key is
# downloaded by every visitor and is readable in devtools no matter where it is
# configured — there is no server-only variant of it. Leave it unset to run in
# trial mode (fully functional, with a TRIAL watermark on every report page).
# Never commit a real key; set it in the environment that runs `npm run build`.
NEXT_PUBLIC_STIMULSOFT_LICENSE_KEY=
