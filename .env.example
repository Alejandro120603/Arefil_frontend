# Browser: same-origin proxy by default. This value is embedded at build time.
NEXT_PUBLIC_API_URL=/backend-api

# Next.js server and proxy: evaluated at runtime.
API_INTERNAL_URL=http://127.0.0.1:8000/api

# Optional per-machine port overrides for `make compose_up`. Copy this file to
# the untracked .env.local and uncomment to run on different ports (useful when
# 8000/3001 are already taken by another project). Keep API_INTERNAL_URL in
# sync with BACKEND_PORT.
# BACKEND_PORT=8000
# FRONTEND_PORT=3001

# Next.js server, behind a reverse proxy only (set by compose files in Docker):
# TRUSTED_ORIGINS=                    # extra public origins accepted for writes via /backend-api
# TRUST_PROXY_FORWARDED_FOR=false     # true only behind a proxy that overwrites X-Forwarded-For (Caddy)
# CLIENT_IP_HEADER=                   # cf-connecting-ip behind Cloudflare; takes precedence
# PUBLIC_ORIGIN=                      # https:// public origin, target of the http->https redirect behind Cloudflare
