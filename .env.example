# Browser: same-origin proxy by default. This value is embedded at build time.
NEXT_PUBLIC_API_URL=/backend-api

# Next.js server and proxy: evaluated at runtime.
API_INTERNAL_URL=http://127.0.0.1:8000/api

# Optional per-machine port overrides for `make run_panel`. Copy this file to
# the untracked .env.local and uncomment to run on different ports (useful when
# 8000/3001 are already taken by another project). Keep API_INTERNAL_URL in
# sync with BACKEND_PORT.
# BACKEND_PORT=8000
# FRONTEND_PORT=3001

# Optional: page that hosts the Stimulsoft designer for the report document
# templates (Frontend #23). The licensed designer is never bundled here; when
# this is unset, Administración still lets you upload, edit and save templates.
# NEXT_PUBLIC_STIMULSOFT_DESIGNER_URL=https://designer.internal.example/stimulsoft
